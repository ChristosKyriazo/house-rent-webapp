# Staging — dev.kaparro.com
dev.kaparro.com {
    tls /etc/caddy/certs/origin.crt /etc/caddy/certs/origin.key

    # Rate limiting — protect API endpoints from abuse
    # Requires the caddy-ratelimit plugin; if not available this block is ignored
    @api path /api/*
    rate_limit @api {
        zone api_zone {
            key {remote_host}
            events 120
            window 1m
        }
    }

    # Serve uploaded files directly from volume
    handle /uploads/* {
        root * /srv
        file_server
    }

    # Everything else goes to Next.js
    handle {
        reverse_proxy app:3000
    }

    # Strict security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        # Content-Security-Policy is set by the Next.js app (next.config.ts) —
        # do NOT also set it here: two CSP headers make browsers enforce the
        # intersection of both policies.
        -Server
    }

    encode gzip

    log {
        output file /var/log/caddy/access.log {
            roll_size 10mb
            roll_keep 7
        }
    }
}

# Production — kaparro.com
kaparro.com, www.kaparro.com {
    tls /etc/caddy/certs/origin.crt /etc/caddy/certs/origin.key

    # Redirect www → apex
    @www host www.kaparro.com
    redir @www https://kaparro.com{uri} permanent

    # Rate limiting — protect API endpoints from abuse
    @api path /api/*
    rate_limit @api {
        zone api_zone {
            key {remote_host}
            events 120
            window 1m
        }
    }

    handle /uploads/* {
        root * /srv
        file_server
    }

    handle {
        reverse_proxy app:3000
    }

    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        # Content-Security-Policy is set by the Next.js app (next.config.ts) —
        # do NOT also set it here: two CSP headers make browsers enforce the
        # intersection of both policies.
        -Server
    }

    encode gzip

    log {
        output file /var/log/caddy/access.log {
            roll_size 10mb
            roll_keep 7
        }
    }
}
