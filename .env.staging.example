# Staging environment — REFERENCE ONLY. Do not copy this to a server.
#
# The server's /opt/house-rent/.env is regenerated wholesale from GitHub
# secrets on every deploy (see docs/OPERATIONS.md → "The server .env is
# disposable"), so hand edits there do not survive. This file lists what the
# `staging` GitHub Environment must contain for that generation to produce a
# working staging box — it is the activation checklist, not a template.
#
# Set these under: Settings → Environments → staging
# Anything unset lands in the server .env as an EMPTY VALUE, silently.

# ─── Gate (repo-level VARIABLE, not a secret) ─────────────────────────────────
# Settings → Secrets and variables → Actions → Variables
# Until this is exactly "true", deploy.yml builds the image but does not deploy.
# DEPLOY_STAGING_ENABLED=true

# ─── Infrastructure (secrets) ─────────────────────────────────────────────────
# MUST differ from SERVER_HOST_PROD. The deploy refuses to run if they match:
# one box cannot be two environments — same volumes, same database, same Caddy.
SERVER_HOST_STAGING=<staging server IP>
DEPLOY_SSH_KEY=<private key whose public half is in deploy's authorized_keys>

# ─── Database (secrets) ───────────────────────────────────────────────────────
# Staging's own Postgres, on the staging box. Never the production database.
DATABASE_URL=postgresql://<user>:<password>@pgbouncer:5432/house_rent
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=house_rent

# ─── Auth (Clerk) ─────────────────────────────────────────────────────────────
# A SEPARATE Clerk development instance. Sharing the live instance means staging
# sign-ups create real production users. The publishable and secret keys must
# come from the same instance or Clerk fails to initialise.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Test-mode keys, plus staging's OWN webhook endpoint: an endpoint is bound to one
# URL, and its signing secret is specific to it. Point a new endpoint at
# https://dev.kaparro.com/api/webhooks/stripe and use that secret here.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PLUS=price_...
STRIPE_PRICE_ID_PRO=price_...

# ─── AI / Maps ────────────────────────────────────────────────────────────────
# A Maps key restricted to the staging domain; a separate OpenAI key keeps staging spend
# visible and lets you cap it independently.
OPENAI_API_KEY=
GOOGLE_MAPS_API_KEY=

# ─── Admin allowlist ──────────────────────────────────────────────────────────
# Empty = nobody can reach /admin in this environment. Clerk user IDs are
# instance-specific, so these are NOT the same values as production's.
ADMIN_CLERK_IDS=
ADMIN_EMAILS=

# ─── Cron ─────────────────────────────────────────────────────────────────────
# Unset means /api/bookings/reminders 401s every request.
CRON_SECRET=<openssl rand -hex 32>

# ─── Observability ────────────────────────────────────────────────────────────
# deploy.yml writes this one secret to both SENTRY_DSN and NEXT_PUBLIC_SENTRY_DSN.
SENTRY_DSN=https://...@sentry.io/...

# ─── E2E test users (optional, but the release gate is weak without them) ─────
# Create these accounts in the staging Clerk instance. If absent, e2e.yml degrades
# the dev → main gate to smoke-only and still reports green.
TEST_OWNER_EMAIL=
TEST_OWNER_PASSWORD=
TEST_RENTER_EMAIL=
TEST_RENTER_PASSWORD=
TEST_BROKER_EMAIL=
TEST_BROKER_PASSWORD=
TEST_BOTH_EMAIL=
TEST_BOTH_PASSWORD=

# ─── Generated by deploy.yml — do NOT set these as secrets ────────────────────
# APP_IMAGE    the immutable sha-<commit>-staging tag that was just built
# APP_ORIGIN   https://dev.kaparro.com
# REDIS_URL    redis://redis:6379, from docker-compose.prod.yml
# LOG_LEVEL    info
# FEATURE_*    GitHub environment VARIABLES, not secrets (default true)
