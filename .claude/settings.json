{
  "permissions": {
    "allow": [
      "Bash(npx playwright *)",
      "Bash(npm run test:e2e*)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push * main:main*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; ext=\"${f##*.}\"; if [[ \"$ext\" == \"ts\" || \"$ext\" == \"tsx\" ]]; then npx eslint --fix \"$f\" 2>/dev/null || true; fi; }"
          }
        ]
      }
    ]
  }
}
