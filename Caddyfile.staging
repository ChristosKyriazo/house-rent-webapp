# Staging Caddy config — serves ONLY staging.kaparro.com.
#
# deploy.yml scp's this file to /opt/house-rent/Caddyfile on the staging server.
# One site block per environment is deliberate: a single shared Caddyfile meant
# the production box also answered on dev.kaparro.com, giving production a
# second public hostname and letting the E2E suite write into it.
#
# Staging — staging.kaparro.com
staging.kaparro.com {
    tls /etc/caddy/certs/origin.crt /etc/caddy/certs/origin.key

    # No rate_limit here: it needs the caddy-ratelimit plugin, which
    # caddy:2-alpine does not ship. An unknown directive makes Caddy reject the
    # whole file, so `caddy reload` kept the old config and a restart would not
    # come up at all. API rate limiting lives in the app (lib/rate-limit.ts).

    # Serve uploaded files directly from volume
    handle /uploads/* {
        root * /srv
        file_server
    }

    # Everything else goes to Next.js
    handle {
        reverse_proxy app:3000
    }

    # Strict security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        # Content-Security-Policy is set by the Next.js app (next.config.ts) —
        # do NOT also set it here: two CSP headers make browsers enforce the
        # intersection of both policies.
        -Server
    }

    encode gzip

    log {
        output file /var/log/caddy/access.log {
            roll_size 10mb
            roll_keep 7
        }
    }
}
