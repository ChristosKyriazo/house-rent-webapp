# Playwright e2e test credentials — copy to .env.test and fill in real values.
# Create each account on dev.kaparro.com, complete the role setup flow, then add credentials here.
# .env.test is gitignored — never commit real credentials.

# Target environment (defaults to staging if not set)
# E2E_BASE_URL=https://dev.kaparro.com

# Owner account — role must be set to "owner" in the app
TEST_OWNER_EMAIL=
TEST_OWNER_PASSWORD=

# Renter account — role must be set to "user" in the app
TEST_RENTER_EMAIL=
TEST_RENTER_PASSWORD=

# Broker account — must be created as a broker (contact admin if needed)
TEST_BROKER_EMAIL=
TEST_BROKER_PASSWORD=

# Both account — role must be set to "both" in the app
TEST_BOTH_EMAIL=
TEST_BOTH_PASSWORD=

# Staging DB connection used by global-teardown to delete data the test
# accounts created during the run (start the SSH tunnel first — see CLAUDE.md).
# Deliberately separate from DATABASE_URL so cleanup can never target the
# wrong database. Leave empty to skip cleanup; set E2E_SKIP_CLEANUP=1 to
# skip it explicitly for a run whose data you want to inspect.
E2E_DATABASE_URL=postgresql://houserent:<password>@localhost:5433/house_rent
