{
  "name": "webapp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/api",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test --project=owner --project=renter --project=broker --project=both",
    "test:e2e:owner": "playwright test --project=owner",
    "test:e2e:renter": "playwright test --project=renter",
    "test:e2e:broker": "playwright test --project=broker",
    "test:e2e:both": "playwright test --project=both",
    "test:e2e:flows": "playwright test --project=flows",
    "test:e2e:role-checks": "playwright test --project=owner --project=broker --project=both",
    "test:e2e:smoke": "playwright test --project=public",
    "test:e2e:report": "playwright show-report",
    "db:up": "docker compose up -d --wait db redis",
    "db:down": "docker compose stop db redis",
    "db:nuke": "docker compose down -v",
    "db:setup": "npm run db:up && prisma migrate deploy && npm run db:seed:areas && npm run db:seed:universities && npm run db:seed:dev",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed:dev": "npx --yes tsx@4.19.2 scripts/seeds/seed-dev.ts",
    "db:seed:universities": "npx --yes tsx@4.19.2 scripts/seeds/seed-universities.ts",
    "db:seed:areas": "npx --yes tsx@4.19.2 scripts/seeds/seed-areas.ts",
    "db:seed:embeddings": "npx --yes tsx@4.19.2 scripts/seeds/seed-embeddings.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.36.5",
    "@clerk/testing": "^2.1.5",
    "@prisma/client": "^5.18.0",
    "@sentry/nextjs": "^10.53.1",
    "ioredis": "^5.11.0",
    "next": "16.0.10",
    "openai": "^6.15.0",
    "pino": "^10.3.1",
    "prisma": "^5.18.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "stripe": "^22.2.3",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "overrides": {
    "import-in-the-middle": "3.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "19.2.7",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.7",
    "baseline-browser-mapping": "^2.10.18",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-security": "^4.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
