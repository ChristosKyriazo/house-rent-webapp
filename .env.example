# Copy to .env and fill in values. Never commit .env.

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL (production / docker-compose)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/house_rent"

# SQLite (quick local dev without Docker)
DATABASE_URL="file:./dev.db"

# ─── Auth (Clerk) ─────────────────────────────────────────────────────────────
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...

# ─── Cal.com ──────────────────────────────────────────────────────────────────
# Token encryption key — required when storing OAuth tokens
# Generate with: openssl rand -hex 32
# CALCOM_TOKEN_ENCRYPTION_KEY=
# CALCOM_API_KEY=

# ─── AI / Maps ────────────────────────────────────────────────────────────────
# OPENAI_API_KEY=
# GOOGLE_MAPS_API_KEY=\n# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=  # same value as above, for map page client-side

# ─── Observability ────────────────────────────────────────────────────────────
# SENTRY_DSN=https://...@sentry.io/...                   # server-side
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...       # client-side (same value)
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# LOG_LEVEL=info     # debug | info | warn | error

# ─── Admin / Security ─────────────────────────────────────────────────────────
# Comma-separated list of email addresses with admin API access
# ADMIN_EMAILS=admin@example.com,ops@example.com
# Secret header value for cron-triggered endpoints (x-cron-secret header)
# Generate with: openssl rand -hex 32
# CRON_SECRET=

# ─── Stripe (payments) ────────────────────────────────────────────────────────
# Use test keys (sk_test_ / pk_test_) — no real charges in test mode
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...          # from Developers → Webhooks after adding endpoint
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PRICE_ID_PLUS=price_...           # recurring monthly price for Plus product
# STRIPE_PRICE_ID_PRO=price_...            # recurring monthly price for Pro product

# ─── Feature flags ────────────────────────────────────────────────────────────
# Set to "false" to disable a feature without a redeploy. Absent = enabled.
# FEATURE_AI_SEARCH=false
# FEATURE_BOOKINGS=false
