# Copy to .env and fill in values. Never commit .env.
# See README.md → "The two databases" before setting DATABASE_URL.

# ─── Database ─────────────────────────────────────────────────────────────────
# DEFAULT: your own local Postgres (pgvector) on port 5432, with seeded fake data.
# One-time setup:  npm run db:setup
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/house_rent"

# Port 5433 is an SSH tunnel to the STAGING database — REAL DATA, shared with UAT.
# Use it read-only, to investigate a staging bug. Anything you write here lands
# in the environment you are supposed to be testing against, so switch back when
# you are done. Start the tunnel first (see docs/OPERATIONS.md):
#   ssh -i ~/.ssh/deploy_key -L 5433:172.18.0.2:5432 deploy@116.203.100.64 -N
# DATABASE_URL="postgresql://houserent:<password>@localhost:5433/house_rent"

# Tests use SQLite and set this themselves — you do not need to.
#   DATABASE_URL="file:./test.db"

# ─── Auth (Clerk) ─────────────────────────────────────────────────────────────
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...

# ─── AI / Maps ────────────────────────────────────────────────────────────────
# OPENAI_API_KEY=
# GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=      # same value as above, for the client-side map page

# Optional per-task model overrides
# OPENAI_FILTER_MODEL=
# OPENAI_VISION_MODEL=
# OPENAI_HOUSE_DESCRIPTION_MODEL=
# OPENAI_COMPATIBILITY_MODEL=

# ─── Cache / rate limiting ────────────────────────────────────────────────────
# Falls back to per-process in-memory when unset.
# REDIS_URL=redis://localhost:6379

# ─── Observability ────────────────────────────────────────────────────────────
# SENTRY_DSN=https://...@sentry.io/...                   # server-side
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...       # client-side (same value)
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# LOG_LEVEL=info     # debug | info | warn | error

# ─── Admin / Security ─────────────────────────────────────────────────────────
# Preferred admin allowlist — comma-separated Clerk user IDs
# ADMIN_CLERK_IDS=user_abc123,user_def456
# Legacy admin allowlist, still honoured as a fallback
# ADMIN_EMAILS=admin@example.com,ops@example.com
# Secret header value for cron-triggered endpoints (x-cron-secret header)
# Generate with: openssl rand -hex 32
# CRON_SECRET=

# ─── Stripe (payments) ────────────────────────────────────────────────────────
# Use test keys (sk_test_) — no real charges in test mode
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...          # from Developers → Webhooks after adding endpoint
# STRIPE_PRICE_ID_PLUS=price_...           # recurring monthly price for Plus product
# STRIPE_PRICE_ID_PRO=price_...            # recurring monthly price for Pro product
# Note: no NEXT_PUBLIC_STRIPE key needed — we use server-side Checkout sessions

# ─── Feature flags ────────────────────────────────────────────────────────────
# Set to "false" to disable a feature without a redeploy. Absent = enabled.
# FEATURE_AI_SEARCH=false
# FEATURE_BOOKINGS=false
# FEATURE_USAGE_ASSISTANT=false  # AI Usage Assistant chatbot (/assistant). Needs OPENAI_API_KEY; admin scope uses ADMIN_EMAILS/ADMIN_CLERK_IDS.

# ─── E2E ──────────────────────────────────────────────────────────────────────
# Playwright targets https://dev.kaparro.com unless overridden.
# E2E_BASE_URL=http://localhost:3000
