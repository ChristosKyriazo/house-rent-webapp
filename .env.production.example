# Production environment — REFERENCE ONLY. Do not copy this to a server.
#
# The server's /opt/house-rent/.env is regenerated wholesale from GitHub
# secrets on every deploy (see docs/OPERATIONS.md → "The server .env is
# disposable"), so hand edits there do not survive. This file lists what the
# `production` GitHub Environment must contain.
#
# Set these under: Settings → Environments → production
# Anything unset lands in the server .env as an EMPTY VALUE, silently.

# ─── Gate (repo-level VARIABLE, not a secret) ─────────────────────────────────
# Production defaults to ENABLED. Set this to "false" only to deliberately
# freeze production deploys; deploy.yml will then build but not ship.
# DEPLOY_PRODUCTION_ENABLED=true

# ─── Infrastructure (secrets) ─────────────────────────────────────────────────
SERVER_HOST_PROD=<production server IP>
DEPLOY_SSH_KEY=<private key whose public half is in deploy's authorized_keys>

# ─── Database (secrets) ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://<user>:<password>@pgbouncer:5432/house_rent
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=house_rent

# ─── Auth (Clerk) ─────────────────────────────────────────────────────────────
# The live Clerk instance. Keep staging on its own development instance.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Live keys, and the webhook endpoint registered for
# https://kaparro.com/api/webhooks/stripe with its own signing secret.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PLUS=price_...
STRIPE_PRICE_ID_PRO=price_...

# ─── AI / Maps ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
GOOGLE_MAPS_API_KEY=

# ─── Admin allowlist ──────────────────────────────────────────────────────────
# Empty = nobody can reach /admin. Clerk user IDs from the LIVE instance.
ADMIN_CLERK_IDS=
ADMIN_EMAILS=

# ─── Cron ─────────────────────────────────────────────────────────────────────
# Unset means /api/bookings/reminders 401s every request, so booking reminders
# never send.
CRON_SECRET=<openssl rand -hex 32>

# ─── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...

# ─── Generated by deploy.yml — do NOT set these as secrets ────────────────────
# APP_IMAGE    the immutable sha-<commit>-production tag that was just built
# APP_ORIGIN   https://kaparro.com
# REDIS_URL    redis://redis:6379, from docker-compose.prod.yml
# LOG_LEVEL    info
# FEATURE_*    GitHub environment VARIABLES, not secrets (default true)
